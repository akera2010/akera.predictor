# AKERATEN v.0.1 - copy to .env and fill in. NEVER commit real keys.
# With no data-source key the backend runs in DEMO mode (simulated data).
DEMO_MODE=                 # true = force simulator, false = force live APIs, empty = auto
TICK_SECONDS=              # default 3 (demo) / 30 (live)

# --- match / odds data sources ---
LIVETENNISAPI_KEY=
LIVETENNISAPI_BASE_URL=
SPORTRADAR_TT_KEY=
SPORTRADAR_TT_ACCESS=trial
APIFY_TOKEN=
APIFY_SOFASCORE_ACTOR=
APIFY_FLASHSCORE_TT_ACTOR=
RAPIDAPI_KEY=
SPORTMICRO_HOST=
SPORTAPI_KEY=
SPORTAPI_BASE_URL=
ODDS_API_KEY=
ODDS_API_REGIONS=eu
BETFAIR_USERNAME=
BETFAIR_PASSWORD=
BETFAIR_APP_KEY=
BETFAIR_TT_EVENT_TYPE=

# --- experts ---
TWITTER_BEARER_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ID=
STATSCORE_API_KEY=
STATSCORE_TIPSTER_URL=
DISCORD_WEBHOOK_SECRET=
ENABLE_WEB_SCRAPING=false   # check each site's robots.txt / ToS first
ENABLE_WEIBO_SCRAPING=false

# --- external models ---
TENNIS_ORACLE_URL=

# --- MCP servers (.mcp.json) ---
ALTSPORTSDATA_API_KEY=
SPORTSCORE_API_KEY=

# --- alerts ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MIN_EDGE=0.05

# --- infrastructure ---
REDIS_URL=                 # e.g. redis://localhost:6379/0 (in-memory cache if empty)
DATABASE_URL=              # default sqlite:///backend/data/akeraten.db ; postgres: postgresql+psycopg://user:pw@host/db

# --- ZCode System VIP Club (pc/zcode_sesion.py, solo en tu PC) ---
ZCODE_USERNAME=
ZCODE_PASSWORD=
# ZCODE_LOGIN_URL=https://zcodesystem.com/vipclub/overview.php
